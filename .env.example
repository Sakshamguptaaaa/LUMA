# LUMA API keys. Copy to `.env` and fill in. `.env` is git-ignored.
# Keys here take priority over keys saved in the app's Settings (OS keychain).
# Installed app: put this file at
#   macOS:   ~/Library/Application Support/com.luma.companion/.env
#   Windows: %APPDATA%\com.luma.companion\.env

# Required unless another model provider answers. https://aistudio.google.com/apikey (use a billing-enabled project)
LUMA_GEMINI_API_KEY=

# Only if Groq answers (Settings → Brain → Model provider). https://console.groq.com/keys
LUMA_GROQ_API_KEY=

# Required: speech-to-text. https://www.assemblyai.com/dashboard
LUMA_ASSEMBLYAI_API_KEY=

# Optional: voice. Without it answers are shown as captions. https://dashboard.sarvam.ai
LUMA_SARVAM_API_KEY=
